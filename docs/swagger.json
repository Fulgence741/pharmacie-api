{
    "swagger": "2.0",
    "info": {
        "description": "API de gestion des pharmacies, gardes et utilisateurs",
        "title": "Pharmacie API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/login": {
            "post": {
                "description": "Permet à un utilisateur de se connecter",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion utilisateur",
                "responses": {
                    "200": {
                        "description": "Connexion réussie",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Email ou mot de passe incorrect",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user": {
            "post": {
                "description": "permet de s'inscrire en remplissant les champs",
                "tags": [
                    "User"
                ],
                "summary": "Inscription d'un utilisateur",
                "responses": {}
            }
        }
    }
}