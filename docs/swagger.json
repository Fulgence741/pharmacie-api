{
    "swagger": "2.0",
    "info": {
        "description": "API de gestion des pharmacies, gardes et utilisateurs",
        "title": "Pharmacie API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/login": {
            "post": {
                "description": "Permet à un utilisateur de se connecter",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Connexion utilisateur",
                "responses": {
                    "200": {
                        "description": "Connexion réussie",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Email ou mot de passe incorrect",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user/list": {
            "post": {
                "description": "Permet d'afficher la liste de tous les utilisateurs",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "User"
                ],
                "summary": "Afficher les utilisateurs",
                "responses": {}
            }
        },
        "/user/{id}/delete": {
            "post": {
                "description": "Permet à l'administrateur de supprimer un utilisateur",
                "tags": [
                    "User"
                ],
                "summary": "Supprimer un utilisateur",
                "responses": {
                    "200": {
                        "description": "Utilisateur supprimé avec succès",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Id invalide",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user/{id}/get": {
            "post": {
                "description": "Permet à l'admin et le pharmacien d'afficher un utilisateur",
                "tags": [
                    "User"
                ],
                "summary": "Afficher un utilisateur",
                "responses": {
                    "200": {
                        "description": "[utilisateur]",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Id invalide",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/user/{id}/role/patch": {
            "post": {
                "description": "Permet à l'admin de modifier le rôle d'un utilisateur",
                "tags": [
                    "User"
                ],
                "summary": "Modifier le rôle",
                "responses": {
                    "200": {
                        "description": "Rôle modifié avec succès",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Données invalides",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}